# New code and data are LF from day one. The DRIVE repo could not do this because
# three live sessions were mid-edit; a new repo has none.
* text=auto eol=lf

# The archive is a faithful record of a CLOSED experiment: byte-exact, never renormalised.
archive/** -text
*.pdf binary
*.png binary

# RFC 3161 timestamp tokens written by pipeline/freeze.py are DER binaries.
manifest.tsr_* binary
